{
    "type": "project",
    "require": {
        "php": "^8.5",
        "ergebnis/composer-normalize": "^2.54.0",
        "ergebnis/phpstan-rules": "^2.14.2",
        "infection/infection": "^0.35.8",
        "kubawerlos/composer-smaller-lock": "^1.1.0",
        "kubawerlos/php-cs-fixer-config": "^5.7",
        "phpmd/phpmd": "^3.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.1",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "phpstan/phpstan-strict-rules": "^2.1.0",
        "shipmonk/composer-dependency-analyser": "^1.8.4",
        "shipmonk/dead-code-detector": "^1.4.2",
        "shipmonk/phpstan-rules": "^4.4.1",
        "squizlabs/php_codesniffer": "^4.0.4",
        "tomasvotruba/type-coverage": "^2.5.1",
        "vimeo/psalm": "^6.20.3"
    },
    "autoload": {
        "psr-4": {
            "PhpCsFixerCustomFixers\\": "../src",
            "PhpCsFixer\\": "../vendor/friendsofphp/php-cs-fixer/src"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": false,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": false,
            "kubawerlos/composer-smaller-lock": true,
            "phpstan/extension-installer": true
        },
        "bump-after-update": true,
        "platform": {
            "php": "8.5"
        }
    },
    "scripts": {
        "analyse": [
            "./check_file_permissions.sh",
            "./check_trailing_whitespaces.sh",
            "@composer validate --strict --working-dir=..",
            "@composer normalize --dry-run ../composer.json",
            "@composer normalize --dry-run",
            "composer-dependency-analyser --composer-json=../composer.json",
            "phpcs",
            "phpmd analyze ../src --format text --ruleset phpmd.xml --no-progress",
            "cd .. && phpstan analyse --configuration=.dev-tools/phpstan.neon --no-progress",
            "psalm --no-cache --no-progress --shepherd"
        ],
        "fix": [
            "@composer normalize --no-check-lock ../composer.json",
            "@composer normalize --no-check-lock",
            "@php ./build-infection-config.php",
            "@php ./generate_readme.php > ../README.md",
            "phpcbf || exit 0"
        ],
        "infection": [
            "infection run"
        ]
    }
}
